@*
    ABC Retail - Azure Storage Web Application
    Author: Genius Mhirizhonga
    Module: CLDV7112 - Cloud Development B
*@
@model Product
@{
    ViewData["Title"] = Model.ProductName;
}

<div class="page-head">
    <div>
        <div class="eyebrow"><a asp-action="Index">Products</a> &middot; @Model.PartitionKey</div>
        <h1>@Model.ProductName</h1>
        <p class="lede">@Model.Description</p>
    </div>
    <div class="head-actions">
        <a class="btn" asp-action="Edit" asp-route-category="@Model.PartitionKey" asp-route-id="@Model.RowKey">Edit</a>
        <a class="btn btn--ghost" asp-action="Delete" asp-route-category="@Model.PartitionKey" asp-route-id="@Model.RowKey">Delete</a>
    </div>
</div>

<div class="split">
    <div>
        <div class="panel">
            <div class="panel-head">
                <h2>Blob Storage</h2>
                <span class="hint">Container: product-images</span>
            </div>
            <div class="panel-body">
                @if (Model.HasImage)
                {
                    <img class="hero-image" src="@Model.ImageUrl" alt="@Model.ProductName" />
                    <div class="kv" style="border-bottom:none">
                        <dt>Blob URL</dt>
                        <dd><a class="blob-url" href="@Model.ImageUrl" target="_blank" rel="noopener">@Model.ImageUrl</a></dd>
                    </div>
                    <div class="kv" style="border-bottom:none;padding-top:0">
                        <dt>Blob name</dt>
                        <dd class="mono" style="font-size:13px">@Model.ImageBlobName</dd>
                    </div>
                }
                else
                {
                    <div class="empty" style="padding:44px 20px">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" />
                            <path d="m21 15-5-5L5 21" />
                        </svg>
                        <h3>No image stored</h3>
                        <p>This product has no blob in the product-images container.</p>
                        <a class="btn" asp-action="Edit" asp-route-category="@Model.PartitionKey" asp-route-id="@Model.RowKey">Upload one</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div>
        <div class="panel">
            <div class="panel-head">
                <h2>Commercials</h2>
            </div>
            <div class="panel-body">
                <div class="kv">
                    <dt>Price</dt>
                    <dd><span class="price">@Money.Format(Model.Price)</span></dd>
                </div>
                <div class="kv">
                    <dt>Stock on hand</dt>
                    <dd>
                        @Model.StockLevel units
                        <span class="badge @(Model.StockLevel == 0 ? "badge--out" : Model.StockLevel < 10 ? "badge--low" : "badge--ok")" style="margin-left:8px">
                            @Model.StockStatus
                        </span>
                    </dd>
                </div>
                <div class="kv" style="border-bottom:none">
                    <dt>Stock value</dt>
                    <dd>@Money.Format(Model.Price * Model.StockLevel)</dd>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Storage record</h2>
                <span class="hint">Azure Table Storage</span>
            </div>
            <div class="panel-body">
                <div class="kv">
                    <dt>Table</dt>
                    <dd class="mono" style="font-size:13px">Products</dd>
                </div>
                <div class="kv">
                    <dt>Partition key (category)</dt>
                    <dd class="mono" style="font-size:13px">@Model.PartitionKey</dd>
                </div>
                <div class="kv">
                    <dt>Row key</dt>
                    <dd class="mono" style="font-size:13px">@Model.RowKey</dd>
                </div>
                <div class="kv" style="border-bottom:none">
                    <dt>Last written</dt>
                    <dd class="mono" style="font-size:13px">@(Model.Timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</dd>
                </div>
            </div>
        </div>
    </div>
</div>
