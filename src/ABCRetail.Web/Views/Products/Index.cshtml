@*
    ABC Retail - Azure Storage Web Application
    Author: Genius Mhirizhonga
    Module: CLDV7112 - Cloud Development B
*@
@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
    var selected = ViewData["Category"] as string;
}

<div class="page-head">
    <div>
        <div class="eyebrow">Azure Table Storage &middot; Products &nbsp;|&nbsp; Blob Storage &middot; product-images</div>
        <h1>Product catalogue</h1>
        <p class="lede">
            Product records live in the Products table, partitioned by category. Each image is
            uploaded to the product-images blob container and referenced here by its blob URL.
        </p>
    </div>
    <div class="head-actions">
        <a class="btn btn--primary" asp-action="Create">Add product</a>
    </div>
</div>

<div class="chips">
    <a class="chip @(string.IsNullOrWhiteSpace(selected) ? "active" : "")" asp-action="Index">All categories</a>
    @foreach (var category in Product.Categories)
    {
        <a class="chip @(selected == category ? "active" : "")" asp-action="Index" asp-route-category="@category">@category</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="panel">
        <div class="empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                <path d="M3.27 6.96 12 12.01l8.73-5.05" /><path d="M12 22.08V12" />
            </svg>
            <h3>@(string.IsNullOrWhiteSpace(selected) ? "The catalogue is empty" : $"Nothing in {selected}")</h3>
            <p>
                Adding a product writes an entity to the Products table and, when an image is
                supplied, uploads a blob to the product-images container.
            </p>
            <a class="btn btn--primary" asp-action="Create">Add product</a>
        </div>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var product in Model)
        {
            <article class="product-card">
                <div class="thumb">
                    @if (product.HasImage)
                    {
                        <img src="@product.ImageUrl" alt="@product.ProductName" loading="lazy" />
                    }
                    else
                    {
                        <div class="placeholder">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" />
                                <path d="m21 15-5-5L5 21" />
                            </svg>
                            No image
                        </div>
                    }
                </div>

                <div class="product-body">
                    <div class="name">
                        <a asp-action="Details" asp-route-category="@product.PartitionKey" asp-route-id="@product.RowKey">@product.ProductName</a>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(product.Description))
                    {
                        <p class="desc">@product.Description</p>
                    }

                    <div class="product-meta">
                        <span class="price">@Money.Format(product.Price)</span>
                        <span class="badge @(product.StockLevel == 0 ? "badge--out" : product.StockLevel < 10 ? "badge--low" : "badge--ok")">
                            @product.StockStatus
                        </span>
                    </div>

                    <div class="product-meta" style="border-top:none;padding-top:9px;margin-top:0">
                        <span class="tag">@product.PartitionKey</span>
                        <span class="row-actions" style="opacity:1">
                            <a class="btn btn--sm btn--ghost" asp-action="Edit" asp-route-category="@product.PartitionKey" asp-route-id="@product.RowKey">Edit</a>
                            <a class="btn btn--sm btn--ghost" asp-action="Delete" asp-route-category="@product.PartitionKey" asp-route-id="@product.RowKey">Delete</a>
                        </span>
                    </div>
                </div>
            </article>
        }
    </div>
}
